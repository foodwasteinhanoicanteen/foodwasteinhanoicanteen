# Copy this file to .env and change the PIN.
# Team PIN: unlocks edit mode on the website and the kitchen screens in CampusMeal.
STAFF_PIN=change-me
# Port for http://localhost:PORT
PORT=5173
# 127.0.0.1 = only this computer. 0.0.0.0 = other devices on the same Wi-Fi can open it too.
HOST=127.0.0.1
